# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=NestJS Base
APP_VERSION=1.0.0
PORT=3000

# -----------------------------------------------------------------------------
# API conventions
# -----------------------------------------------------------------------------
# Final routes look like: /{API_PREFIX}/v{API_VERSION}/...
API_PREFIX=api
API_VERSION=1
# Comma-separated list. Use * to reflect any origin (credentials are allowed).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Enable when the app runs behind a reverse proxy/load balancer.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h

# Demo login endpoint. Disabled automatically in production unless explicitly
# set to true. Replace AuthService with a real user store for real projects.
DEMO_AUTH_ENABLED=true
DEMO_AUTH_EMAIL=admin@example.com
DEMO_AUTH_PASSWORD=Admin@123456

# -----------------------------------------------------------------------------
# Rate limiting (milliseconds)
# -----------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# false in production for newline-delimited JSON logs.
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# Swagger / OpenAPI
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=NestJS Base API
SWAGGER_DESCRIPTION=Opinionated NestJS base: configuration, validation, errors, logging, Swagger and security.
